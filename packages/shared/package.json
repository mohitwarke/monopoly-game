    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@monopoly/eslint-config": "workspace:*",
    "@monopoly/tsconfig": "workspace:*",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "zod": "^3.22.4"
  }
}