{
  "name": "@monopoly/rules-engine",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./processor": "./src/processor.ts",
    "./dsl": "./src/dsl.ts",
